# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (server only). The model names are optional; these are the defaults.
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_GENERATION_MODEL="gpt-4o-mini"
# Audio notes are transcribed (chat models don't accept audio input)
OPENAI_TRANSCRIPTION_MODEL="whisper-1"

# Public site URL. Used for sitemap, Open Graph and Stripe return links.
# In production set the real origin, for example https://bitacora.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: shown on /terms and /privacy as the contact address
NEXT_PUBLIC_SUPPORT_EMAIL=

# Stripe (server secret and webhook secret never go to the browser)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRO_PRICE_ID=price_your_pro_price
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Wompi (Colombia). The private key, events secret and integrity secret stay on the server.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_your_public_key
WOMPI_PRIVATE_KEY=prv_test_your_private_key
WOMPI_EVENTS_SECRET=test_events_your_secret
WOMPI_INTEGRITY_SECRET=test_integrity_your_secret
# Pro price in Colombian cents. 3200000 = 32.000 COP.
WOMPI_PRO_AMOUNT_IN_CENTS=3200000
